# Copy to .env.local and fill in. .env.local is git-ignored.
# Supabase dashboard > Project Settings > API.

# Public project URL and the anon (publishable) key. Read-only: Row Level Security only allows
# SELECT on published rows. Used by the server to read the journal. Never sent to the browser.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Only for `npm run seed` (writes the sample rows). Bypasses Row Level Security: keep it local,
# never commit it, never put it in Vercel's public env or client code.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Lets Supabase tell the site to refresh after you edit rows (POST /api/revalidate with
# the header `x-revalidate-secret`). Generate a long random string.
REVALIDATE_SECRET=

# Optional override: "local" forces the built-in sample content even when Supabase is configured.
# CONTENT_SOURCE=local
