# Copy to .env.local and fill in. .env.local is git-ignored.
#
# Supabase is used for ONE thing: the guest desk (visitor cards). Your postcards, trips, places,
# cafés and stories live in the repository (content/ and public/images/), not in a database.
# Without these two variables the site works fully, and the guest desk shows as closed.
#
# Supabase dashboard > Project Settings > API.

SUPABASE_URL=
# The anon (publishable) key. It can only read visible cards and send new ones.
SUPABASE_ANON_KEY=

# Optional. Any long random string. Mixed into the anonymous daily code used to limit spam.
VISITOR_SALT=

# Do NOT add the service-role key to this project or to Vercel. The site never needs it.
